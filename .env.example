# Copy this file to .env.local and replace these placeholders with values from your Supabase project.
# These are browser-visible public settings. Never paste a Supabase secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY

# Older Supabase projects may provide a legacy anon key. If you use it, use this variable instead:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_PUBLIC_ANON_KEY
